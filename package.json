{
  "name": "dbide",
  "productName": "DBIDE",
  "version": "0.0.1",
  "private": true,
  "description": "A fast, keyboard-first data IDE for MySQL, MongoDB, Redis and RabbitMQ",
  "author": "Hamid Ebrahimi",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:demo": "node scripts/dev-demo.mjs",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --app",
    "smoke:live": "pnpm build && node scripts/live-smoke.mjs",
    "smoke:mongo": "pnpm build && node scripts/mongo-smoke.mjs",
    "smoke:rabbitmq": "pnpm build && node scripts/rabbit-smoke.mjs",
    "smoke:redis": "pnpm build && node scripts/redis-smoke.mjs",
    "smoke:shots": "pnpm build && node scripts/smoke.mjs --shots .shots",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmdk": "^1.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.13",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  }
}
